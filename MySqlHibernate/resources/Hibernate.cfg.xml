<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- Configuración de la conexión JDBC -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://dns11036.phdns11.es:3306/ad2526_alba_duque</property>
        <property name="hibernate.connection.username">ad2526_alba_duque</property>
        <property name="hibernate.connection.password">12345</property>
        
        <!-- Pool de conexiones -->
        <property name="hibernate.connection.pool_size">1</property>
        
        <!-- Dialecto SQL -->
        <property name="hibernate.dialect">org.hibernate.dialect.MariaDBDialect</property>
        
        <!-- Mostrar SQL -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        
        <!-- Contexto de sesión -->
        <property name="hibernate.current_session_context_class">thread</property>
        
        <!-- Actualización automática del esquema -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Mapeo de clases -->
        <mapping class="clases.Alumnado"/>
        <mapping class="clases.Direccion"/>
        <mapping class="clases.Email"/>
    </session-factory>
</hibernate-configuration>